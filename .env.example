TELEGRAM_BOT_TOKEN=your_telegram_bot_token
AMVERA_API_TOKEN=your_amvera_inference_token
AMVERA_API_BASE=https://inference.waw0.amvera.ru
AMVERA_MODEL=deepseek-v3
LOG_LEVEL=INFO
# LOG_DIR не задавайте на Amvera — бот сам пишет в /data/logs (раздел Data).
# Локально можно: LOG_DIR=logs
LOG_CSV_FILE=bot.csv
# Полный дамп HTTP (учебный режим). На Amvera: DEBUG_HTTP=1 и перезапуск.
# Пустые getUpdates (~каждые 100 сек) не дампятся; дамп при входящем сообщении / ошибке / sendMessage / LLM.
DEBUG_HTTP=0
# history.db на Amvera создаётся в /data автоматически
