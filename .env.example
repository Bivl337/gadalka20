TELEGRAM_BOT_TOKEN=your_telegram_bot_token
AMVERA_API_TOKEN=your_amvera_inference_token
AMVERA_API_BASE=https://inference.waw0.amvera.ru
AMVERA_MODEL=deepseek-v3
LOG_LEVEL=INFO
# LOG_DIR не задавайте на Amvera — бот сам пишет в /data/logs (раздел Data).
# Локально можно: LOG_DIR=logs
LOG_CSV_FILE=bot.csv
